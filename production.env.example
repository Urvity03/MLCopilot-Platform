# ==============================================================================
# MLCopilot Platform — Production Environment Configuration Example
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
PORT=8000

# Security & Authentication
# IMPORTANT: Generate a strong secret key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=production_change_this_to_a_minimum_64_character_secure_random_hex_string_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=https://mlcopilot.yourdomain.com,https://app.yourdomain.com

# PostgreSQL + pgvector Database Connection
POSTGRES_USER=mlcopilot
POSTGRES_PASSWORD=production_secure_db_password
POSTGRES_DB=mlcopilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mlcopilot:production_secure_db_password@postgres:5432/mlcopilot_db

# Redis Cache & Task Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Vector Embeddings & RAG Configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CHUNKS=3

# LLM Infrastructure (Ollama Default)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# MinIO / S3 Document Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=production_minio_access_key
MINIO_SECRET_KEY=production_minio_secret_key
MINIO_BUCKET_NAME=mlcopilot-documents
MINIO_USE_SSL=false

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=https://mlcopilot.yourdomain.com/api/v1
